<header class="pink-theme py-8 md:py-12 px-6 border-b border-pink-100" style="min-height: auto !important;">
    <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-4xl md:text-6xl font-black text-gray-900 mb-4">Research &amp; <span class="text-pink-500 italic">Clinical Insights</span></h1>
        <p class="text-gray-600 text-lg">Daily wellness protocols and scientific papers by Shringarika Mishra &amp; Team.</p>
    </div>
</header>

<main class="max-w-5xl mx-auto px-6 py-16 space-y-12">
    <div class="blog-post-content-area full-content">
        {{ content | safe }}
    </div>

    {% if page.url == "/blogs/" or page.url == "/blogs.html" %}
    <div class="space-y-10">
        {% for article in collections.blogs %}
        <div class="article-card bg-white border border-gray-100 rounded-[2.5rem] p-8 shadow-sm hover:shadow-md transition" id="{{ article.fileSlug }}">
            <div class="flex flex-col md:flex-row gap-8 items-center">
                <div class="md:w-1/3 w-full">
                    {% set artImg = "images/logo.webp" %}
                    {% if article.data.image %}
                        {% set artImg = article.data.image %}
                    {% endif %}
                    <div class="w-full h-[200px] rounded-2xl overflow-hidden border border-pink-100 shadow-sm bg-slate-50">
                        <img src="{{ artImg | url }}" alt="{{ article.data.title }}" class="w-full h-full object-cover object-top" loading="lazy">
                    </div>
                </div>
                <div class="md:w-2/3 text-left w-full">
                    {% if article.data.publishDate %}
                        <div class="font-bold text-xs uppercase tracking-wider mb-2 flex items-center gap-1.5" style="color: #059669 !important;">
                            <i class="far fa-calendar-alt text-[11px]" style="color: #10b981 !important;"></i> 
                            {{ article.data.publishDate }}
                        </div>
                    {% endif %}
                    <h2 class="text-2xl font-bold text-gray-900 mb-3">{{ article.data.title }}</h2>
                    <p class="text-gray-600 line-clamp-3 mb-6">{{ article.data.description or article.templateContent | striptags | truncate(180) }}</p>
                    <a href="{{ article.url | url }}" class="inline-flex items-center px-8 py-3 bg-pink-600 text-white font-bold rounded-full hover:bg-pink-700 transition shadow-lg">
                        Read Full Clinical Analysis <i class="fas fa-arrow-right ml-2 text-sm"></i>
                    </a>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
    {% endif %}

    <div class="bg-gray-900 text-white p-8 rounded-[2rem] mt-12 shadow-2xl max-w-5xl mx-auto">
        <div class="flex flex-col md:flex-row items-center gap-8">
            <img src="/images/shringarika.webp" alt="Shringarika Mishra BHU Scholar" class="w-32 h-32 rounded-full border-4 border-pink-500 object-cover">
            <div>
                <h4 class="text-2xl font-bold mb-2">About Shringarika Mishra</h4>
                <p class="text-sm text-gray-300 leading-relaxed">
                    Gold Medalist (University of Patanjali) &amp; NET JRF (AIR 2). Research Scholar at <strong>Banaras Hindu University (BHU)</strong> specializing in Clinical Yoga. 11+ years of experience with 16 published research papers.
                </p>
                <div class="flex gap-4 mt-4">
                    <a href="https://www.researchgate.net/profile/Shringarika-Mishra" target="_blank" class="text-xs text-blue-400 font-bold hover:underline">ResearchGate Profile</a>
                    <a href="https://scholar.google.com/citations?user=FAp2CnkAAAAJ&amp;hl=en" target="_blank" class="text-xs text-red-400 font-bold hover:underline">Google Scholar</a>
                </div>
            </div>
        </div>
    </div>

    <p class="text-[10px] text-gray-400 mt-8 text-center leading-relaxed italic border-t border-gray-100 pt-4">
        <strong>Medical Disclaimer:</strong> This research-based article is for educational purposes only and not a substitute for professional medical advice, diagnosis, or treatment. Always consult with your physician before beginning any new clinical yoga protocol.
    </p>
</main>

<script>
document.addEventListener("DOMContentLoaded", function() {
    // 1. Target both specific class or broad article card layouts to find article paragraphs safely
    const contentContainer = document.querySelector(".full-content") || document.querySelector(".article-card");
    if (!contentContainer) return;

    // 2. TARGETED SAFETY CHECK: Stop immediately if a report analysis box is explicitly found inside text content
    const textContent = contentContainer.innerHTML;
    if (textContent.includes("I%20want%20to%20get%20a%20free%20consultation") || textContent.includes("Get Your Free Medical Report Analysis")) {
        console.log("Medical report block already explicitly configured on this route. Injection terminated.");
        return;
    }

    // 3. Gather paragraph chunks or semantic block elements directly inside the post area
    // This looks for top-level paragraphs, sections, or subsections
    const structuralBlocks = Array.from(contentContainer.querySelectorAll("p, section, .full-content > div, .article-card > div")).filter(block => {
        // Exclude elements that belong to metadata, headers, or buttons
        return !block.closest('header') && !block.closest('.blog-post-content-area + div');
    });

    if (structuralBlocks.length > 1) {
        // 4. Calculate a clean midpoint block that represents a true break after a paragraph ends
        const midpoint = Math.floor(structuralBlocks.length / 2);
        const targetInsertionBlock = structuralBlocks[midpoint - 1];

        // 5. Generate pristine green layout block wrapper matching your branding values
        const bannerWrapper = document.createElement("div");
        bannerWrapper.className = "my-10 max-w-3xl mx-auto border border-green-600 rounded-[2.5rem] bg-white p-8 text-center relative overflow-hidden shadow-md w-full clear-both";
        bannerWrapper.innerHTML = `
            <div class="absolute top-0 right-0 bg-green-600 text-white text-[10px] font-black uppercase tracking-widest px-4 py-1.5 rounded-bl-xl shadow-sm">FREE SERVICE</div>
            <h3 class="text-2xl font-bold text-gray-900 mb-3">Get Your Free Medical Report Analysis</h3>
            <p class="mb-6 text-gray-600 text-base leading-relaxed max-w-2xl mx-auto">
                Stop guessing your recovery path. Click the button below to text our team directly on WhatsApp. Attach your latest ultrasound or lab reports, and get a private, 15-minute clinical evaluation directly from BHU Research Scholar Shringarika Mishra.
            </p>
            <a href="https://wa.me/919559827280?text=Hello%20Team%2C%20I%20want%20to%20get%20a%20free%20consultation.%20I%20am%20attaching%20my%20medical%20reports%20here." 
               target="_blank" 
               rel="noopener noreferrer"
               class="block text-center bg-green-600 hover:bg-green-700 text-white px-6 py-4 rounded-xl font-black text-lg tracking-wide uppercase shadow-md transition transform hover:-translate-y-0.5 active:translate-y-0 max-w-xl mx-auto"
               style="text-decoration: none !important; color: white !important; display: block !important;">
                UPLOAD YOUR MEDICAL REPORTS
            </a>
        `;

        // 6. Push cleanly after the closing paragraph tag to fully maintain readability flow
        targetInsertionBlock.insertAdjacentElement('afterend', bannerWrapper);
        console.log("Successfully placed medical template inside structural flow break.");
    }
});
</script>