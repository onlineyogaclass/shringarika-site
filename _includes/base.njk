        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        width: 100%;
        text-align: left;
    }

    .premium-tier-card {
        background-color: #ffffff !important;
        border: 1px solid #fbcfe8 !important;
        border-left: 5px solid #db2777 !important;
        border-radius: 1.25rem;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: stretch;
        gap: 1.25rem;
        transition: all 0.3s ease;
    }

