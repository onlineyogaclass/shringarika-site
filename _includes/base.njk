    <script>

// ADVANCED MOBILE LAZY SCRIPT INJECTOR FOR SWIPER
     document.addEventListener('DOMContentLoaded', function() {
         const testimonialContainer = document.querySelector('.testimonialSwiper');

         if (testimonialContainer) {
             const swiperObserver = new IntersectionObserver(function(entries, observer) {
                 entries.forEach(entry => {
                     if (entry.isIntersecting) {
                         console.log("Carousel in viewport. Fetching swiper bundle asset library.");

                         // 1. Inject the javascript file dynamically
                         const swiperScript = document.createElement('script');
                         swiperScript.src = "/assets/swiper-bundle.min.js";
                         swiperScript.async = true;

                         swiperScript.onload = function() {
                             // Initialize swiper instantly once script completes downloading
                             const swiper = new Swiper('.testimonialSwiper', {
                                 slidesPerView: 1,
                                 spaceBetween: 30,
                                 loop: true,
                                 speed: 600,
                                 autoplay: { delay: 7000, disableOnInteraction: false },
                                 freeMode: true,
                                 grabCursor: true,
                                 breakpoints: { 768: { slidesPerView: 2 }, 1024: { slidesPerView: 3 } },
                             });
                         };

                         document.body.appendChild(swiperScript);
                         swiperObserver.unobserve(testimonialContainer); // Turn off observer once loaded
                     }
                 });
             }, { rootMargin: "200px 0px" }); // Starts loading 200px before the element scrolls into view

             swiperObserver.observe(testimonialContainer);
         }
     });

        // Unified Mobile Menu, Dropdown, and Smart Router Logic
        const openBtn = document.getElementById('mobile-menu-button');
        const closeBtn = document.getElementById('close-menu');
        const menu = document.getElementById('mobile-menu');
        const programsToggle = document.getElementById('mobile-programs-toggle');
        const programsDropdown = document.getElementById('mobile-programs-dropdown');
        const chevron = document.getElementById('mobile-chevron');

        // Open Mobile Menu
        openBtn.addEventListener('click', () => {
            menu.classList.remove('hidden');
            setTimeout(() => {
                menu.classList.remove('translate-x-full', 'pointer-events-none');
            }, 10);
        });

        // Close Mobile Menu Function
        const closeMenu = () => {
            menu.classList.add('translate-x-full', 'pointer-events-none');
            setTimeout(() => { 
                menu.classList.add('hidden'); 
                // Reset dropdown when closing menu
                programsDropdown.classList.add('hidden');
                programsDropdown.classList.remove('flex');
                if(chevron) chevron.style.transform = 'rotate(0deg)';
            }, 300);
        };
        
        closeBtn.addEventListener('click', closeMenu);

        // Accordion toggle behavior for Mobile "Programs" link
        if (programsToggle) {
            programsToggle.addEventListener('click', (e) => {
                e.preventDefault();
                const isHidden = programsDropdown.classList.contains('hidden');
                if (isHidden) {
                    programsDropdown.classList.remove('hidden');
                    programsDropdown.classList.add('flex');
                    chevron.style.transform = 'rotate(180deg)';
                } else {
                    programsDropdown.classList.add('hidden');
                    programsDropdown.classList.remove('flex');
                    chevron.style.transform = 'rotate(0deg)';
                }
            });
        }

        // Close menu on regular link click, but keep open if it's the toggle
        menu.querySelectorAll('a:not(.mobile-dropdown-item)').forEach(link => { 
            link.addEventListener('click', closeMenu); 
        });

        // REPAIRED DROPDOWN ROUTER: Automatically corrects the address bar window URL hash match
        document.querySelectorAll('.dropdown-menu a, .mobile-dropdown-item').forEach(link => {
            link.addEventListener('click', function(e) {
                // Close mobile menu if item is clicked safely
                if(link.classList.contains('mobile-dropdown-item')) {
                    setTimeout(closeMenu, 150);
                }
                
                const url = new URL(this.href, window.location.origin);
                const hash = url.hash.substring(1);

                if (hash && typeof showProgram === "function") {
                    // Prevent the native jumping bug from locking the wrong name string in the URL window bar
                    e.preventDefault();
                    
                    // Force the address bar text string to match the condition clicked
                    history.pushState(null, null, url.pathname + url.hash);
                    
                    setTimeout(() => {
                        showProgram(hash);
                    }, 250); 
                }
            });
        });

        // Service Worker
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js');
            });
        }

        // Load Google Reviews with Safe Fallback for Older Computers
        function injectFeaturable() {
            const container = document.getElementById('featurable-eee66ac1-335d-451c-8d9f-8e9335eb8c2b');
            if (container && !container.hasAttribute('data-loaded')) {
                
                // Smart Theme Adaptation for Older Monitors
                const isDarkPage = window.getComputedStyle(document.body).backgroundColor === "rgb(15, 23, 42)";
                container.style.color = isDarkPage ? "#f8fafc" : "#1f2937"; 

                const script = document.createElement('script');
                script.src = "https://featurable.com/assets/bundle.js";
                script.defer = true;
                
                script.onerror = function() {
                    console.warn("Review widget script bypassed safely.");
                };

                document.body.appendChild(script);
                container.setAttribute('data-loaded', 'true');
            }
        }

        // REPAIRED SMART ROUTER: Safe user detection with zero duplicate asset loads
        if (navigator.userAgent.includes('Googlebot') || navigator.userAgent.includes('Chrome-Lighthouse')) {
            // If Google is crawling, fetch the widget immediately to parse its automatic dynamic schema
            injectFeaturable();
        } else {
            // For human traffic, trigger cleanly on first natural movement without background timers crashing the layout
            window.addEventListener('scroll', injectFeaturable, { passive: true, once: true });
            window.addEventListener('touchstart', injectFeaturable, { passive: true, once: true });
        }

    </script>
    
